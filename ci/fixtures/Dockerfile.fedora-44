# Pinned Fedora 44 fixture image: base locked by digest, package list
# spelled out, nothing installed later. The distro_fixtures tests compile
# the fixture applications against these libraries inside the container,
# and the image's PipeWire stack with wireplumber is the sound server
# the audio matrix cells start. pipewire-pulse is the pulse socket of
# the desktop sound stack the audio cells start, and binutils' strip
# strips the packed libraries.
# Xvfb gives the pinned host a display so a GUI application can be run
# against its bundle here; the suite itself needs none.
FROM fedora:44@sha256:15da97ed9aa94dd3d92c3925eb89520f6c80e07ea7ee24cba848d1f8b6912b3e

RUN dnf install -y --setopt=install_weak_deps=False \
        alsa-lib-devel \
        binutils \
        file \
        gcc \
        gcc-c++ \
        gtk3-devel \
        patchelf \
        pkgconf \
        pipewire \
        pipewire-alsa \
        pipewire-pulse \
        pipewire-utils \
        qt6-qtbase-devel \
        wireplumber \
        xorg-x11-server-Xvfb \
    && dnf clean all
