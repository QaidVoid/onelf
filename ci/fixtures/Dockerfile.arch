# Arch Linux fixture image: base locked by digest, package list spelled
# out, nothing installed later. Arch mirrors keep no older versions, so
# the packages are whatever the repositories hold when the image is
# built, which keeps this host the newest glibc line the audio matrix
# plays on. The image's PipeWire stack is the sound server the matrix
# cells start, pipewire-pulse is the pulse socket of that desktop sound
# stack, and binutils' strip strips the packed libraries.
# Xvfb gives the pinned host a display so a GUI application can be run
# against its bundle here; the suite itself needs none.
FROM archlinux:base@sha256:fcee73ea1b96e236248f53a213f71276cc9072d9025b58bce9915e32f19963ae

RUN pacman -Syu --noconfirm --needed \
        alsa-lib \
        binutils \
        gcc \
        pkgconf \
        pipewire \
        pipewire-alsa \
        pipewire-pulse \
        wireplumber \
        xorg-server-xvfb \
    && pacman -Scc --noconfirm
